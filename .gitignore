# LaTeX build outputs and caches
build/
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.idx
*.ilg
*.ind
*.lof
*.log
*.lot
*.nav
*.out
*.run.xml
*.snm
*.synctex
*.synctex(busy)
*.synctex.gz
*.toc
*.vrb
*.xdv

# Compiled PDFs (build artifacts)
*.pdf
# But track curated content PDFs explicitly
!content/*.pdf
!content/**/*.pdf

# Operating system and editor artifacts
.DS_Store
Thumbs.db
*~
*.swp
*.swo
.vscode/
.idea/

# Scratch & temporary directories
scratch/
tmp/
.tempmediaStorage/

# Standalone book caches and downloaded build tools
.cache/
__pycache__/
**/tools/tectonic/
**/tools/tectonic.zip
**/tools/python-packages/

# Vector logos are source assets for each independently exported book
!book-*/assets/*.pdf

.creds
claude_code.ps1
