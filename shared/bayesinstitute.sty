%% bayesinstitute.sty — Bayes Institute Book Theme
%% Building What Lasts series
%% Fonts:  EB Garamond (display) · Manrope (body)
%% Colors: Burgundy palette, B&W print-safe
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{bayesinstitute}[2026/10/26 Bayes Institute Book Theme]

% ── Core packages ────────────────────────────────────────────────────────────
\RequirePackage{fontspec}
\RequirePackage[table]{xcolor}
\RequirePackage{geometry}
\RequirePackage{titlesec}
\RequirePackage{fancyhdr}
\RequirePackage{needspace}
\RequirePackage{microtype}
\RequirePackage{ragged2e}
\RequirePackage{import}
\RequirePackage{enumitem}
\RequirePackage{booktabs}
\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{tikz}
\RequirePackage{float}
\RequirePackage{hyperref}
\RequirePackage{tabularx}
\RequirePackage{tcolorbox}
\tcbuselibrary{most}

% ── Color palette ────────────────────────────────────────────────────────────
% Primary brand accent — prints as very dark gray in B&W
\definecolor{BayesBurgundy}{HTML}{5B0F1A}
\definecolor{BayesDeepBurgundy}{HTML}{430A13}
% Text
\definecolor{BayesInk}{HTML}{211D1E}
\definecolor{BayesSoftInk}{HTML}{696164}
% Surfaces and rules
\definecolor{BayesRule}{HTML}{E9E4DF}
\definecolor{BayesWarmGray}{HTML}{F7F6F4}
% On-dark text
\definecolor{BayesWarmWhite}{HTML}{F7F2EE}

% Set default text color
\color{BayesInk}
\hypersetup{
  colorlinks=true,
  linkcolor=BayesDeepBurgundy,
  citecolor=BayesBurgundy,
  urlcolor=BayesBurgundy,
  hidelinks
}

% ── Fonts ────────────────────────────────────────────────────────────────────
% Body: Manrope (variable weight — regular=400, semibold=600)
\setmainfont{Manrope-Regular}[
  Path           = ../fonts/,
  Extension      = .ttf,
  BoldFont       = Manrope-Regular,
  BoldFeatures   = {Weight=600},
  ItalicFont     = Manrope-Regular,
  ItalicFeatures = {FakeSlant=0.15},
  BoldItalicFont = Manrope-Regular,
  BoldItalicFeatures = {Weight=600, FakeSlant=0.15}
]

% Display: EB Garamond (variable weight serif — for headings, pull quotes)
\newfontfamily\BayesDisplayFont{EBGaramond-Regular}[
  Path           = ../fonts/,
  Extension      = .ttf,
  ItalicFont     = EBGaramond-Italic,
  BoldFont       = EBGaramond-Regular,
  BoldFeatures   = {Weight=700}
]

% ── Page geometry (6 × 9 trade paperback) ────────────────────────────────────
\geometry{
  paperwidth    = 6in,
  paperheight   = 9in,
  inner         = 0.875in,
  outer         = 0.75in,
  top           = 0.75in,
  bottom        = 0.875in,
  headheight    = 20pt,
  headsep       = 10pt,
  footskip      = 24pt,
  includeheadfoot
}

% ── Typography ───────────────────────────────────────────────────────────────
\setlength{\parindent}{13pt}
\setlength{\parskip}{1pt plus 0.5pt}
\linespread{1.08}
\setlength{\RaggedRightRightskip}{0pt plus 1.5em}
\hyphenpenalty=10000
\exhyphenpenalty=50
\tolerance=9999
\hbadness=9999
\widowpenalty=9000
\clubpenalty=9000

% ── Section counter depth ───────────────────────────────────────────────────
\setcounter{secnumdepth}{1}
\setcounter{tocdepth}{1}

% ── Chapter heading ──────────────────────────────────────────────────────────
% CHAPTER N label · large Garamond title · two-tone rule
\newcommand{\BIChapterRule}{%
  \vskip 5pt
  \hbox to\linewidth{%
    \color{BayesBurgundy}\vrule width 2.5cm height 1.1pt depth 0pt
    \color{BayesRule}\leaders\hrule height 0.4pt\hfill}%
  \vskip 5pt
}

\titleformat{\chapter}[display]
  {\normalfont}
  {\small\bfseries\color{BayesBurgundy}%
   \MakeUppercase{\chaptertitlename}\enspace\thechapter}
  {6pt}
  {\BayesDisplayFont\fontsize{26}{31}\selectfont\color{BayesInk}}
  [\BIChapterRule]
\titlespacing*{\chapter}{0pt}{10pt}{14pt}

% Unnumbered chapter (frontmatter, backmatter)
\titleformat{name=\chapter,numberless}[display]
  {\normalfont}{}
  {0pt}
  {\BayesDisplayFont\fontsize{24}{29}\selectfont\color{BayesInk}}
  [\BIChapterRule]
\titlespacing*{name=\chapter,numberless}{0pt}{10pt}{14pt}

% ── Section heading ──────────────────────────────────────────────────────────
% Garamond title · Burgundy section number · two-tone anchor rule below
\newcommand{\BISectionRule}{%
  \vskip 4pt
  \hbox to\linewidth{%
    \color{BayesBurgundy}\vrule width 2cm height 0.8pt depth 0pt
    \color{BayesRule}\leaders\hrule height 0.4pt\hfill}%
}

\titleformat{\section}
  {\needspace{5\baselineskip}%
   \BayesDisplayFont\fontsize{14}{17}\selectfont\color{BayesInk}}
  {\textcolor{BayesBurgundy}{\thesection}}{0.75em}{}
  [\BISectionRule]
\titlespacing*{\section}{0pt}{20pt plus 2pt minus 2pt}{10pt}

% ── Subsection heading ───────────────────────────────────────────────────────
% Manrope semibold · inline left-dash accent
\titleformat{\subsection}
  {\needspace{4\baselineskip}%
   \normalfont\bfseries\fontsize{11}{14}\selectfont\color{BayesInk}}
  {}{0pt}%
  {\leavevmode\textcolor{BayesBurgundy}{\rule[0.3ex]{10pt}{1pt}}\hspace{7pt}}
\titlespacing*{\subsection}{0pt}{13pt plus 2pt minus 1pt}{5pt}

% ── Subsubsection ────────────────────────────────────────────────────────────
\titleformat{\subsubsection}
  {\needspace{3\baselineskip}%
   \normalfont\bfseries\small\color{BayesSoftInk}}
  {}{0pt}{}
\titlespacing*{\subsubsection}{0pt}{10pt plus 1pt}{3pt}

% ── Running headers and footers ──────────────────────────────────────────────
\renewcommand{\chaptermark}[1]{\markboth{\thechapter\enspace#1}{}}
\renewcommand{\sectionmark}[1]{\markright{\thesection\enspace#1}}

% Truncate long marks
\newsavebox{\BIHeadBox}
\newcommand{\BIRunningHead}[1]{%
  \sbox{\BIHeadBox}{\footnotesize\color{BayesSoftInk}\nouppercase{#1}}%
  \ifdim\wd\BIHeadBox>\dimexpr\headwidth-3.5em\relax
    \resizebox{\dimexpr\headwidth-3.5em\relax}{!}{\usebox{\BIHeadBox}}%
  \else
    \usebox{\BIHeadBox}%
  \fi
}

\pagestyle{fancy}
\fancyhf{}
\fancyhead[LE]{%
  \footnotesize
  \textbf{\textcolor{BayesBurgundy}{\thepage}}%
  \enspace\textcolor{BayesRule}{\textbar}\enspace
  \BIRunningHead{\leftmark}%
}
\fancyhead[RO]{%
  \footnotesize
  \BIRunningHead{\rightmark}%
  \enspace\textcolor{BayesRule}{\textbar}\enspace
  \textbf{\textcolor{BayesBurgundy}{\thepage}}%
}
\fancyfoot{}
\renewcommand{\headrulewidth}{0.45pt}
\renewcommand{\headrule}{%
  \hbox to\headwidth{%
    {\color{BayesBurgundy}\rule{2cm}{\headrulewidth}}%
    {\color{BayesRule}\leaders\hrule height\headrulewidth\hfill}%
  }%
}

% Chapter opening pages: page number at outer foot, no header
\fancypagestyle{plain}{%
  \fancyhf{}%
  \fancyfoot[LE,RO]{\footnotesize\bfseries\color{BayesBurgundy}\thepage}%
  \renewcommand{\headrulewidth}{0pt}%
}

% Suppress headers on blank verso pages before chapters
\let\BIOrigClearDoublePage\cleardoublepage
\renewcommand{\cleardoublepage}{%
  \clearpage{\pagestyle{empty}\BIOrigClearDoublePage}%
}

% ── Callout environments ─────────────────────────────────────────────────────
\newenvironment{InsightBox}[1]{%
  \begin{tcolorbox}[
    enhanced, colback=BayesWarmGray, colframe=BayesRule,
    boxrule=0.4pt, arc=2pt,
    borderline west={2.5pt}{0pt}{BayesBurgundy},
    left=10pt, right=10pt, top=6pt, bottom=6pt,
    before skip=10pt, after skip=10pt,
    title={\small\bfseries\color{BayesBurgundy}#1},
    fonttitle=\normalfont\bfseries\small\color{BayesBurgundy},
    attach boxed title to top left={yshift=-2pt,xshift=8pt},
    boxed title style={colback=BayesWarmGray,colframe=BayesRule,boxrule=0.4pt}
  ]
  \small\color{BayesInk}
}{%
  \end{tcolorbox}%
}

\newenvironment{ExampleBox}[1]{%
  \begin{tcolorbox}[
    enhanced, colback=white, colframe=BayesRule,
    boxrule=0.4pt, arc=2pt,
    left=10pt, right=10pt, top=6pt, bottom=6pt,
    before skip=10pt, after skip=10pt,
    title={\small\itshape\color{BayesSoftInk}#1},
    fonttitle=\normalfont\itshape\small\color{BayesSoftInk},
    attach boxed title to top left={yshift=-2pt,xshift=8pt},
    boxed title style={colback=white,colframe=BayesRule,boxrule=0.4pt}
  ]
  \small\color{BayesInk}
}{%
  \end{tcolorbox}%
}

\newenvironment{KeyIdea}{%
  \begin{tcolorbox}[
    enhanced, colback=BayesWarmGray!60!white,
    colframe=BayesBurgundy, boxrule=0.6pt, arc=2pt,
    left=10pt, right=10pt, top=7pt, bottom=7pt,
    before skip=12pt, after skip=12pt
  ]
  \normalfont\itshape\color{BayesInk}
}{%
  \end{tcolorbox}%
}

% ── Lists ────────────────────────────────────────────────────────────────────
\setlist[itemize]{
  leftmargin=16pt, itemsep=2pt, topsep=4pt, parsep=0pt,
  label={\small\textcolor{BayesBurgundy}{$\bullet$}}
}
\setlist[enumerate]{
  leftmargin=16pt, itemsep=2pt, topsep=4pt, parsep=0pt
}

% ── Table rules ──────────────────────────────────────────────────────────────
\arrayrulecolor{BayesRule}
\renewcommand{\arraystretch}{1.2}

% ── Title page command ───────────────────────────────────────────────────────
% Usage: \BITitlePage{Book N of Five}{The Title}{Core question}{Author}
\newcommand{\BITitlePage}[4]{%
  \begin{titlepage}
  \thispagestyle{empty}
  \color{BayesInk}
  \begin{tikzpicture}[remember picture, overlay]
    \fill[BayesBurgundy]
      (current page.north west) rectangle
      ([yshift=-28mm]current page.north east);
    \node[anchor=north west, inner sep=0pt] at
      ([xshift=0.875in, yshift=-8mm]current page.north west)
      {\color{BayesWarmWhite}\footnotesize\bfseries\MakeUppercase{Building What Lasts}};
    \node[anchor=north east, inner sep=0pt] at
      ([xshift=-0.75in, yshift=-8mm]current page.north east)
      {\color{BayesWarmWhite!70}\footnotesize\bfseries\MakeUppercase{#1}};
    \draw[BayesWarmWhite!30, line width=0.4pt]
      ([xshift=0.875in, yshift=-14mm]current page.north west) --
      ([xshift=-0.75in, yshift=-14mm]current page.north east);
    \node[anchor=west, inner sep=0pt] at
      ([xshift=0.875in, yshift=-21mm]current page.north west)
      {\color{BayesWarmWhite!60}\tiny\MakeUppercase{Bayes Institute}};
  \end{tikzpicture}%
  \vspace*{42mm}
  \noindent\hspace{0.875in}%
  \begin{minipage}{\dimexpr\linewidth-1.625in\relax}
    \RaggedRight
    {\BayesDisplayFont\fontsize{36}{42}\selectfont\color{BayesInk}#2\par}
    \vspace{8pt}
    {\color{BayesSoftInk}\fontsize{12}{17}\selectfont\itshape #3\par}
    \vspace{16pt}
    {\color{BayesBurgundy}\rule{3cm}{1.2pt}}\par
    \vspace{12pt}
    {\normalfont\fontsize{13}{16}\selectfont\color{BayesInk}#4\par}
  \end{minipage}
  \vfill
  \noindent\hspace{0.875in}%
  {\small\color{BayesSoftInk}%
   % Logo: place full-primary.pdf here once converted from SVG
   \textbf{\color{BayesBurgundy}BAYES}\enspace INSTITUTE}
  \vspace{18mm}
  \end{titlepage}
}

% ── Notes and Sources section ─────────────────────────────────────────────────
\newcommand{\NotesSection}{%
  \section*{Notes and Sources}
  \addcontentsline{toc}{section}{Notes and Sources}
}
